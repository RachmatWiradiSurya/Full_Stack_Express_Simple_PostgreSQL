<%- include("partials/header", { pageTitle: "Admin Dashboard" }) %>
<div class="container py-4 py-lg-5">
  <div class="admin-hero">
    <div class="eyebrow text-white-50">Control center</div>
    <h1 class="h2 fw-bold mb-1">Dashboard administrator</h1>
    <p>Pantau aktivitas workspace, pengguna, dan seluruh data dari satu panel.</p>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card stat-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-center"><span class="stat-label">Total pengguna</span><span class="stat-icon" style="background:#eeedff;color:#625aff"><i class="bi bi-people"></i></span></div><div class="stat-value"><%= stats.total_users %></div><div class="small text-muted">Akun terdaftar</div></div></div></div>
    <div class="col-md-4"><div class="card stat-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-center"><span class="stat-label">Total data</span><span class="stat-icon" style="background:#e4f8f0;color:#1b9b70"><i class="bi bi-collection"></i></span></div><div class="stat-value"><%= stats.total_items %></div><div class="small text-muted">Item tersimpan</div></div></div></div>
    <div class="col-md-4"><div class="card stat-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-center"><span class="stat-label">Administrator</span><span class="stat-icon" style="background:#fff2e7;color:#e58b3e"><i class="bi bi-shield-check"></i></span></div><div class="stat-value"><%= stats.total_admins %></div><div class="small text-muted">Akun dengan akses admin</div></div></div></div>
  </div>

  <section class="card mb-4"><div class="card-body">
    <div class="panel-heading"><div><h2 class="panel-title">Manajemen pengguna</h2><small class="text-muted">Daftar seluruh akun yang terdaftar</small></div><span class="badge rounded-pill badge-soft"><%= users.length %> akun</span></div>
    <div class="table-responsive"><table class="table align-middle">
      <thead><tr><th>Pengguna</th><th>Role</th><th>Terdaftar</th><th>Aksi</th></tr></thead>
      <tbody><% users.forEach(user => { %><tr>
        <td><div class="d-flex align-items-center gap-2"><span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span><div><strong><%= user.name %></strong><div class="small text-muted"><%= user.email %></div></div></div></td>
        <td><span class="badge rounded-pill <%= user.role === 'admin' ? 'text-bg-primary' : 'text-bg-light' %>"><%= user.role %></span></td>
        <td class="small text-muted"><%= new Date(user.created_at).toLocaleDateString("id-ID") %></td>
        <td><% if (String(user.id) !== String(currentUser.id)) { %><form method="POST" action="/admin/users/<%= user.id %>/delete" onsubmit="return confirm('Hapus pengguna ini beserta seluruh datanya?')"><button class="btn btn-sm btn-danger"><i class="bi bi-person-x me-1"></i>Hapus</button></form><% } else { %><span class="small text-muted">Akun aktif</span><% } %></td>
      </tr><% }) %></tbody>
    </table></div>
  </div></section>

  <section class="card"><div class="card-body">
    <div class="panel-heading"><div><h2 class="panel-title">Seluruh data</h2><small class="text-muted">Data dari semua pengguna workspace</small></div><span class="badge rounded-pill badge-soft"><%= items.length %> item</span></div>
    <div class="table-responsive"><table class="table align-middle">
      <thead><tr><th>Informasi</th><th>Pemilik</th><th>Lampiran</th><th>Aksi</th></tr></thead>
      <tbody><% items.forEach(item => { %><tr>
        <td><strong><%= item.name %></strong><div class="small text-muted"><%= item.description || "Tanpa deskripsi" %></div></td>
        <td><strong><%= item.owner_name %></strong><div class="small text-muted"><%= item.owner_email %></div></td>
        <td><div class="d-flex gap-2"><% if (item.photo_filename) { %><a class="file-pill" href="/admin/items/<%= item.id %>/photo" target="_blank" rel="noopener"><i class="bi bi-image"></i> Foto</a><% } %><% if (item.document_filename) { %><a class="file-pill" href="/admin/items/<%= item.id %>/download"><i class="bi bi-file-earmark"></i> File</a><% } %><% if (!item.photo_filename && !item.document_filename) { %><span class="text-muted small">-</span><% } %></div></td>
        <td><form method="POST" action="/admin/items/<%= item.id %>/delete" onsubmit="return confirm('Hapus data ini?')"><button class="btn btn-sm btn-danger"><i class="bi bi-trash3 me-1"></i>Hapus</button></form></td>
      </tr><% }) %></tbody>
    </table></div>
  </div></section>
</div>
<%- include("partials/footer") %>
