<%- include("partials/header", { pageTitle: item ? "Edit Data" : "Tambah Data" }) %>
<div class="container py-4 py-lg-5" style="max-width:820px">
  <a href="/items" class="text-decoration-none small fw-bold"><i class="bi bi-arrow-left me-1"></i>Kembali ke koleksi</a>
  <div class="mt-4 mb-4"><div class="eyebrow">Workspace kamu</div><h1 class="page-title"><%= item ? "Perbarui data" : "Buat koleksi baru" %></h1><p class="page-subtitle">Lengkapi detail dan tambahkan lampiran jika diperlukan.</p></div>
  <form method="POST" enctype="multipart/form-data" action="<%= item ? `/items/${item.id}/update` : '/items' %>" class="card">
    <div class="card-body p-4 p-md-5">
      <div class="mb-4"><label class="form-label">Nama data <span class="text-danger">*</span></label><input class="form-control" name="name" maxlength="150" placeholder="Contoh: Laptop kerja" required value="<%= item ? item.name : '' %>"></div>
      <div class="mb-4"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description" rows="4" placeholder="Tuliskan detail atau catatan singkat..."><%= item ? item.description || '' : '' %></textarea></div>
      <div class="border-top pt-4 mb-4"><h2 class="h6 fw-bold mb-1"><i class="bi bi-image me-2 text-primary"></i>Foto</h2><p class="small text-muted mb-3">Format JPG, PNG, WEBP · Maksimal 5 MB</p>
        <% if (item && item.photo_filename) { %><img class="preview d-block mb-3" src="/items/<%= item.id %>/photo" alt="Foto saat ini"><% } %>
        <input class="form-control" type="file" id="photo" name="photo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
        <img id="preview" class="preview d-none mt-3" alt="Preview foto baru">
      </div>
      <div class="border-top pt-4"><h2 class="h6 fw-bold mb-1"><i class="bi bi-paperclip me-2 text-primary"></i>Dokumen</h2><p class="small text-muted mb-3">PDF, DOC, DOCX, XLS, XLSX, TXT · Maksimal 5 MB</p>
        <% if (item && item.document_original_name) { %><div class="file-pill mb-3"><i class="bi bi-file-earmark-check"></i><%= item.document_original_name %></div><% } %>
        <input class="form-control" type="file" name="document" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt">
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-end gap-2 px-4 px-md-5 py-3"><a href="/items" class="btn btn-outline-secondary">Batal</a><button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Simpan data</button></div>
  </form>
</div>
<script>
document.getElementById("photo").addEventListener("change", (e) => {
  const img = document.getElementById("preview");
  if (!e.target.files[0]) { img.src = ""; img.classList.add("d-none"); return; }
  img.src = URL.createObjectURL(e.target.files[0]);
  img.classList.remove("d-none");
});
</script>
<%- include("partials/footer") %>
