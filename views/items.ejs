<%- include("partials/header", { pageTitle: "Data Saya" }) %>
<div class="container py-4 py-lg-5">
  <div class="page-heading">
    <div><div class="eyebrow">Personal workspace</div><h1 class="page-title">Koleksi data kamu</h1><p class="page-subtitle">Kelola informasi, foto, dan dokumen dalam satu tempat.</p></div>
    <a href="/items/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Tambah data</a>
  </div>
  <div class="d-flex align-items-center justify-content-between mb-3">
    <span class="small fw-bold text-secondary"><i class="bi bi-grid me-1"></i> Semua koleksi</span>
    <span class="badge rounded-pill badge-soft px-3 py-2"><%= items.length %> item</span>
  </div>
  <% if (!items.length) { %>
    <div class="empty-state"><div class="empty-icon"><i class="bi bi-folder2-open"></i></div><h2 class="h5 fw-bold">Belum ada koleksi</h2><p class="text-muted mb-4">Mulai dengan menambahkan data pertama kamu.</p><a href="/items/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Tambah data pertama</a></div>
  <% } else { %>
    <div class="row g-4">
      <% items.forEach(item => { %>
      <div class="col-md-6 col-lg-4"><div class="card item-card h-100">
        <% if (item.photo_filename) { %><img class="item-photo" src="/items/<%= item.id %>/photo" alt="Foto <%= item.name %>"><% } else { %><div class="photo-placeholder"><i class="bi bi-image"></i></div><% } %>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h2 class="item-name mb-0"><%= item.name %></h2><span class="badge rounded-pill text-bg-light">#<%= item.id %></span></div>
          <p class="item-description"><%= item.description || "Belum ada deskripsi untuk item ini." %></p>
          <% if (item.document_filename) { %><a href="/items/<%= item.id %>/download" class="file-pill"><i class="bi bi-file-earmark-arrow-down"></i> Download dokumen</a><% } %>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
          <small class="text-muted"><i class="bi bi-clock me-1"></i><%= new Date(item.created_at).toLocaleDateString("id-ID") %></small>
          <div class="d-flex gap-2"><a href="/items/<%= item.id %>/edit" class="btn btn-sm btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a><form method="POST" action="/items/<%= item.id %>/delete" onsubmit="return confirm('Hapus data ini?')"><button class="btn btn-sm btn-danger"><i class="bi bi-trash3 me-1"></i>Hapus</button></form></div>
        </div>
      </div></div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include("partials/footer") %>
